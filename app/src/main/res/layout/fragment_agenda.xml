<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page"
    android:weightSum="2"
    tools:context=".fragments.AgendaFragment">

    <!-- ========== CALENDAR SECTION ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.15"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_white"
            app:strokeWidth="0dp"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp"
                android:paddingBottom="8dp">

                <!-- ===== MONTH/YEAR HEADER ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageButton
                        android:id="@+id/btn_mes_anterior"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_chevron_left"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Mes anterior"
                        android:scaleType="center"
                        android:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_mes_anio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.02" />

                    <ImageButton
                        android:id="@+id/btn_mes_siguiente"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_chevron_right"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Mes siguiente"
                        android:scaleType="center"
                        android:tint="@color/text_secondary" />
                </LinearLayout>

                <!-- ===== DAY HEADERS ===== -->
                <GridLayout
                    android:id="@+id/calendar_day_headers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="7"
                    android:layout_marginBottom="4dp">

                    <TextView style="@style/CalendarDayHeader" android:text="D" />
                    <TextView style="@style/CalendarDayHeader" android:text="L" />
                    <TextView style="@style/CalendarDayHeader" android:text="M" />
                    <TextView style="@style/CalendarDayHeader" android:text="M" />
                    <TextView style="@style/CalendarDayHeader" android:text="J" />
                    <TextView style="@style/CalendarDayHeader" android:text="V" />
                    <TextView style="@style/CalendarDayHeader" android:text="S" />
                </GridLayout>

                <!-- ===== DIVIDER ===== -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/divider" />

                <!-- ===== CALENDAR GRID ===== -->
                <GridLayout
                    android:id="@+id/calendar_grid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:columnCount="7" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ===== SEPARADOR VISUAL ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="3dp"
        android:paddingHorizontal="16dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/primary_surface" />
    </LinearLayout>

    <!-- ========== ACTIVITIES SECTION ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.85"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <!-- Section Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="6dp">

            <TextView
                style="@style/SectionTitle"
                android:text="Actividades del día" />

            <TextView
                android:id="@+id/tv_fecha_seleccionada"
                style="@style/SectionSubtitle"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="10dp" />

        <!-- Activity List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_actividades_dia"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:nestedScrollingEnabled="true"
            android:clipToPadding="false"
            android:paddingBottom="2dp"
            tools:listitem="@layout/item_actividad" />

        <!-- Empty State -->
        <TextView
            android:id="@+id/tv_sin_actividades"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="No hay actividades para este día"
            android:textColor="@color/text_tertiary"
            android:textSize="14sp"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
